# Copy to .env.local for local work. On Vercel, set these in Project > Settings > Environment Variables.

# Your live address, no trailing slash. Needed for canonical links, sitemap and social previews.
# On Vercel it is filled in automatically from VERCEL_PROJECT_PRODUCTION_URL if you leave this empty.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Optional: a Formspree form address (formspree.io, free). Empty = the forms open the visitor's mail app instead.
NEXT_PUBLIC_FORMSPREE_URL=

# Optional: set to 1 to load Vercel Analytics and Speed Insights. Off by default to protect the Lighthouse score.
NEXT_PUBLIC_ANALYTICS=0
